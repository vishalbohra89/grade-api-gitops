cat > /tmp/argo-check.sh <<'EOF'
echo "--- app repoURL:"
kubectl get application cvs-2 -n argocd -o jsonpath='{.spec.source.repoURL}'; echo
echo "--- connected repo URLs:"
for s in $(kubectl get secret -n argocd -l argocd.argoproj.io/secret-type=repository -o name); do
  kubectl get $s -n argocd -o jsonpath='{.data.url}' | base64 -d; echo
done
echo "--- repo-server log:"
kubectl logs -n argocd deploy/argocd-repo-server --tail=30 | grep -i "cvs.deploy\|git\|not found\|auth" | tail -8
EOF
sh /tmp/argo-check.sh
